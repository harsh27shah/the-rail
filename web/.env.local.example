# Copy this file to .env.local and fill in real values. .env.local is never committed to
# GitHub (see .gitignore) — this .example file is just documentation.

# From your Anthropic console (console.anthropic.com → API Keys).
ANTHROPIC_API_KEY=

# From your Supabase project → Settings → Data API.
# "Project URL" on that page:
SUPABASE_URL=
# The "service_role" secret key on that same page (NOT the "anon" public key — the
# service role key is used because this app runs in single-owner mode with no per-user
# accounts yet; see PROJECT.md §5).
SUPABASE_SERVICE_ROLE_KEY=

# From Google AI Studio (aistudio.google.com → Get API key). Used only for the garment
# cleanup/extraction step (src/lib/gemini.ts) — a different capability than the Anthropic
# key above, which only tags photos and can't generate/edit images.
GEMINI_API_KEY=
